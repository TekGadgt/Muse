    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "esbuild": "^0.21.0",
    "eslint": "^9.0.0",
    "eslint-plugin-obsidianmd": "0.4.2",
    "obsidian": "latest",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.57.2",
    "vitest": "^2.1.9"
  }
}
